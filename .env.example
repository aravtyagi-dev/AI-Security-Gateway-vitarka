# LLM Provider Configuration: mock | gemini | openai_compatible | ollama
# Defaults to 'mock' if no keys are provided
LLM_PROVIDER=mock
LLM_MODEL=default

# Gemini API Key (if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI or OpenAI-Compatible API Key (if LLM_PROVIDER=openai_compatible)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Base URL (if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Security Gateway Configuration
AUDIT_KEY=ai-gateway-super-secret-hmac-salt-key-2026
AUDIT_DB_PATH=audit.db
POLICIES_PATH=policies.yaml
GATEWAY_URL=http://localhost:8000
